    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0"
