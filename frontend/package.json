{
  "name": "house-cost-web",
  "private": true,
  "version": "1.2.0",
  "description": "House costs' interface: a thin client of its API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node build/compile-messages.ts && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@jmerhar/frontend-config": "^0.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "31.0.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@jmerhar/jigkit": "0.21.0",
    "@lucide/svelte": "1.73.0",
    "@simplewebauthn/browser": "14.0.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
